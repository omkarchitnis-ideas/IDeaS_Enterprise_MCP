# ==============================================================================
# SAS IDeaS Enterprise Master Unified Super-MCP Server Environment Config
# ==============================================================================

# Server Port (Default: 8550)
UNIFIED_MCP_PORT=8550

# ------------------------------------------------------------------------------
# Domain 1: Salesforce Enterprise Middleware (Port 4000)
# ------------------------------------------------------------------------------
SFDC_MIDDLEWARE_URL=http://172.27.210.162:4000
SFDC_API_KEY=your_sfdc_admin_api_key_here

# ------------------------------------------------------------------------------
# Domain 2: CMA Edge Gateway (Port 8555)
# ------------------------------------------------------------------------------
CMA_GATEWAY_URL=http://172.27.210.162:8555
CMA_API_KEY=your_cma_api_key_here

# ------------------------------------------------------------------------------
# Domain 3: Optix SQL Server Cluster (Port 1433 across 3 cluster nodes)
# ------------------------------------------------------------------------------
OPTIX_DB_USERNAME=optixro
OPTIX_DB_PASSWORD=your_optix_readonly_password_here

# ------------------------------------------------------------------------------
# Domain 4: Confluence Knowledge Base & Qdrant Vector Engine
# ------------------------------------------------------------------------------
CONFLUENCE_URL=https://ideasinc.atlassian.net/wiki
CONFLUENCE_USERNAME=your_username@ideas.com
CONFLUENCE_API_TOKEN=your_atlassian_api_token_here
QDRANT_URL=http://172.27.210.162:6333

# ------------------------------------------------------------------------------
# Domain 5: Datadog Observability & Telemetry
# ------------------------------------------------------------------------------
DATADOG_API_KEY=your_datadog_api_key_here
DATADOG_APP_KEY=your_datadog_app_key_here
DATADOG_SITE=datadoghq.com

# ------------------------------------------------------------------------------
# Domain 6: UPS & FDS Platform
# ------------------------------------------------------------------------------
FDS_BASE_URL=https://fds.ideasrms.com
CEDF_BASE_URL=https://cedf.ideasrms.com
UPS_BEARER_TOKEN=optional_static_bearer_token_here
